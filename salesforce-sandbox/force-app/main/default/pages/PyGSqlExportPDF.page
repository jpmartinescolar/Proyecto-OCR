<apex:page controller="PyGSqlExportPDFController"
           action="{!init}"
           renderAs="pdf"
           applyHtmlTag="false"
           applyBodyTag="false"
           showHeader="false"
           sidebar="false"
           standardStylesheets="false"
           language="es">
<html>
<head>
<title>Cuenta de Pérdidas y Ganancias</title>
<style type="text/css">
    @page {
        size: A4 portrait;
        margin: 1.4cm 1.4cm 1.9cm 1.4cm;
        @bottom-left {
            content: "Cuenta de Pérdidas y Ganancias · Plan General de Contabilidad";
            font-family: Helvetica, Arial, sans-serif;
            font-size: 7.5pt;
            color: #9aa7b5;
        }
        @bottom-right {
            content: "Página " counter(page) " de " counter(pages);
            font-family: Helvetica, Arial, sans-serif;
            font-size: 7.5pt;
            color: #9aa7b5;
        }
    }
    body {
        font-family: Helvetica, Arial, sans-serif;
        font-size: 8.5pt;
        color: #33475b;
        line-height: 1.25;
        margin: 0;
    }

    /* ===== CABECERA ===== */
    .topbar {
        height: 5pt;
        background: #14395c;
        margin-bottom: 0.42cm;
    }
    .kicker { width: 100%; border-collapse: collapse; }
    .kicker td {
        font-size: 7.5pt;
        text-transform: uppercase;
        letter-spacing: 0.22em;
        color: #2878a8;
        font-weight: 700;
        padding: 0;
    }
    .kicker td.right { text-align: right; }
    .title {
        font-size: 19pt;
        font-weight: 700;
        color: #14395c;
        letter-spacing: -0.2pt;
        margin: 0.18cm 0 0.1cm 0;
    }
    .empresa {
        font-size: 11.5pt;
        font-weight: 700;
        color: #14395c;
        margin: 0 0 0.4cm 0;
    }

    /* ===== FICHA (meta) ===== */
    .meta {
        width: 100%;
        border-collapse: collapse;
        border-top: 1pt solid #dfe5ec;
        border-bottom: 1pt solid #dfe5ec;
        margin-bottom: 0.55cm;
    }
    .meta td {
        padding: 0.16cm 0 0.16cm 0;
        vertical-align: top;
    }
    .meta td.right { text-align: right; }
    .meta .m-lbl {
        font-size: 6.8pt;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: #8a97a8;
        font-weight: 700;
        margin-bottom: 0.06cm;
        white-space: nowrap;
    }
    .meta .m-val {
        font-size: 8.8pt;
        color: #14395c;
        font-weight: 700;
        white-space: nowrap;
    }

    /* ===== TABLA ===== */
    .pyg {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        border: 1pt solid #dfe5ec;
    }
    .pyg col.col-concepto     { width: 60%; }
    .pyg col.col-amount       { width: 20%; }
    .pyg col.col-concepto-nc  { width: 75%; }
    .pyg col.col-amount-nc    { width: 25%; }

    .pyg thead th {
        background: #14395c;
        color: #ffffff;
        padding: 5.5pt 10pt;
        text-align: right;
        font-size: 7.5pt;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-weight: 700;
        vertical-align: middle;
    }
    .pyg thead th.concepto { text-align: left; }
    .pyg tbody td {
        padding: 3.8pt 10pt;
        border-bottom: 0.75pt solid #e7ecf2;
        font-size: 8pt;
        line-height: 1.2;
    }
    .pyg td.amount {
        text-align: right;
        white-space: nowrap;
        border-left: 0.75pt solid #e7ecf2;
        font-weight: 700;
    }
    .pyg td.concepto { text-align: left; word-wrap: break-word; }

    /* Epígrafes (blanco) y cuentas desglosadas (sombreadas) */
    .row-item td   { background: #ffffff; color: #33475b; }
    .row-cuenta td { background: #f5f7f9; color: #5b6b7d; font-size: 7.5pt; padding-top: 2.8pt; padding-bottom: 2.8pt; }
    .row-cuenta td.concepto { padding-left: 0.85cm; }
    .row-cuenta td.amount { font-weight: 400; }
    .row-cuenta .pos { color: #3b6c96; }
    /* Títulos de cuenta escritos en MAYÚSCULAS: talla menor para no destacar sobre el código */
    .row-cuenta-mayus td.concepto { font-size: 6.8pt; }
    .codigo {
        color: #5b6b7d;
        font-family: 'Courier New', Courier, monospace;
        font-size: 7.3pt;
        margin-right: 0.5em;
        font-weight: 700;
    }

    /* Subtotales A.x (banda azul clara) */
    .row-subtotal td {
        background: #e9f1f8;
        color: #14395c;
        font-weight: 700;
        font-size: 8.3pt;
        padding: 5pt 10pt;
        border-top: 1pt solid #cfdeed;
        border-bottom: 1pt solid #cfdeed;
    }
    .row-subtotal td.amount { border-left: 0.75pt solid #cfdeed; }

    /* Fila final: Resultado del ejercicio (banda azul marino) */
    .row-final td {
        background: #14395c;
        color: #ffffff;
        font-weight: 700;
        font-size: 9pt;
        padding: 6pt 10pt;
    }
    .row-final td.amount { border-left: 0.75pt solid #2c5379; }

    /* Signos */
    .pos  { color: #14395c; }
    .neg  { color: #c0392b; }
    .zero { color: #9aa7b5; font-weight: 400; }
    .row-subtotal .pos, .row-subtotal .zero { color: #14395c; font-weight: 700; }
    .row-subtotal .neg  { color: #c0392b; }
    .row-final .pos, .row-final .zero { color: #ffffff; font-weight: 700; }
    .row-final .neg { color: #ffb3ac; }

    .err {
        background: #fef1f1;
        border: 1pt solid #ea001e;
        color: #ba0517;
        padding: 0.3cm;
        margin-top: 0.5cm;
        font-weight: bold;
    }
</style>
</head>
<body>

<!-- CABECERA -->
<div class="topbar"></div>
<table class="kicker">
    <tr>
        <td>Informe financiero</td>
        <td class="right">Documento confidencial</td>
    </tr>
</table>
<h1 class="title">Cuenta de Pérdidas y Ganancias</h1>
<div class="empresa">{!empresaLabel}</div>

<!-- FICHA -->
<table class="meta">
    <tr>
        <td>
            <div class="m-lbl">Ejercicio {!anioActual}</div>
            <div class="m-val">{!fechaDesdeLabel} &#8211; {!fechaHastaLabel}</div>
        </td>
        <apex:outputPanel rendered="{!conComparativo}" layout="none">
            <td>
                <div class="m-lbl">Comparativo {!anioComparado}</div>
                <div class="m-val">{!fechaCompDesdeLabel} &#8211; {!fechaCompHastaLabel}</div>
            </td>
        </apex:outputPanel>
        <td class="right">
            <div class="m-lbl">Moneda</div>
            <div class="m-val">Euro (EUR)</div>
        </td>
        <td class="right">
            <div class="m-lbl">Fecha de emisión</div>
            <div class="m-val">{!generadoEnLabel}</div>
        </td>
    </tr>
</table>

<apex:outputPanel rendered="{!errorMsg != null}" layout="block">
    <div class="err">{!errorMsg}</div>
</apex:outputPanel>

<apex:outputPanel rendered="{!errorMsg == null}" layout="block">

<!-- TABLA -->
<table class="pyg">
    <colgroup>
        <apex:outputPanel rendered="{!conComparativo}" layout="none">
            <col class="col-concepto"/>
            <col class="col-amount"/>
            <col class="col-amount"/>
        </apex:outputPanel>
        <apex:outputPanel rendered="{!NOT(conComparativo)}" layout="none">
            <col class="col-concepto-nc"/>
            <col class="col-amount-nc"/>
        </apex:outputPanel>
    </colgroup>
    <thead>
        <tr>
            <th class="concepto">Concepto</th>
            <th class="amount">Año {!anioActual}</th>
            <apex:outputPanel rendered="{!conComparativo}" layout="none">
                <th class="amount">Año {!anioComparado}</th>
            </apex:outputPanel>
        </tr>
    </thead>
    <tbody>
        <apex:repeat value="{!rows}" var="r">
            <tr class="{!r.rowClass}">
                <apex:outputPanel rendered="{!r.isCuenta}" layout="none">
                    <td class="concepto">
                        <span class="codigo">{!r.codigoCuenta}</span>{!r.concepto}
                    </td>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!NOT(r.isCuenta)}" layout="none">
                    <td class="concepto">{!r.concepto}</td>
                </apex:outputPanel>

                <td class="amount">
                    <span class="{!r.actualSigno}">{!r.actualTexto}</span>
                </td>

                <apex:outputPanel rendered="{!conComparativo}" layout="none">
                    <td class="amount">
                        <span class="{!r.comparadoSigno}">{!r.comparadoTexto}</span>
                    </td>
                </apex:outputPanel>
            </tr>
        </apex:repeat>
    </tbody>
</table>

</apex:outputPanel>

</body>
</html>
</apex:page>