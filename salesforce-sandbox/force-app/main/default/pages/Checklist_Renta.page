<apex:page standardController="Checklist_Renta__c" recordSetVar="Checklist Renta" showHeader="false" id="muopp" lightningStylesheets="true">
    <apex:slds />
    <apex:form id="muform">
        <apex:pageBlock title="Update Status" mode="edit" id="mub1">
        <apex:pageMessages />
            <apex:pageBlockSection id="mus1">
                <apex:inputField value="{!Checklist_Renta__c.Completado__c}" id="Comnpletado">
                    <apex:actionSupport event="onchange" rerender="muselectedlist"/>
                </apex:inputField>
            </apex:pageBlockSection>
            <apex:pageBlockButtons location="bottom" id="mubut">
                <apex:commandButton value="Save" action="{!save}" id="butsav"/>
                <apex:commandButton value="Cancel" action="{!cancel}" id="butcan"/>
            </apex:pageBlockButtons>
        </apex:pageBlock>
        <apex:pageBlock title="Selected Opportunities" id="muselectedlist">
            <apex:pageBlockTable value="{!selected}" var="j" id="mutab">
                <apex:column value="{!j.Name}" id="jName"/>               
                <apex:column value="{!j.Asunto__c}"/>
            </apex:pageBlockTable>
        </apex:pageBlock>
    </apex:form>
</apex:page>