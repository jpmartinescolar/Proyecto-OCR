<apex:component ><div id="search" class="CoveoCaseCreationInterface" data-enable-history="true" data-design="new">
    <div class="CoveoAnalytics"></div>
    <div class="coveo-main-section" id="coveo-case-creation-main-section">
        <div class="coveo-case-creation-column">
            <div class="CoveoCaseCreation">
                <div class="coveo-result-frame">
                    <div class="coveo-result-row coveo-case-creation-row">
                        <div class="coveo-result-cell coveo-case-creation-cell">
                            <div class="CoveoField" data-title="Subject" data-case-field="Subject">
                            </div>
                        </div>
                    </div>
                    <div class="coveo-result-row coveo-case-creation-row">
                        <div class="coveo-result-cell coveo-case-creation-cell">
                            <div class="CoveoField" data-title="Description" data-case-field="Description" data-number-of-lines="10" data-add-qre="false">
                            </div>
                        </div>
                    </div>
                    <div class="coveo-result-row coveo-case-creation-row">
                        <div class="coveo-result-cell coveo-case-creation-cell" style="text-align:right">
                            <div class="CoveoSubmit">
                            </div>
                        </div>
                        <div class="coveo-result-cell coveo-case-creation-cell" style="text-align:right; width:70px">
                            <div class="CoveoCancel">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="coveo-results-column" id="coveo-case-creation-results-column">
            <div class="CoveoText" data-value="Recommended Solutions" data-size="18px"></div>
            <div class="coveo-tab-section" id="coveo-case-creation-tab-section">
                <a class="CoveoTab" data-id="SalesforceAccount" data-caption="Accounts" data-expression="@objecttype==(Account)"></a>
<a class="CoveoTab" data-id="SalesforceCase" data-caption="Cases" data-expression="@objecttype==(Case)"></a>
<a class="CoveoTab" data-id="SalesforceChatter" data-caption="Chatter" data-expression="@objecttype==(FeedItem,FeedComment) (NOT @sftype==(ContentPost,CollaborationGroupCreated,CreateRecordEvent))"></a>
<a class="CoveoTab" data-id="SalesforceContact" data-caption="Contacts" data-expression="@objecttype==(Contact)"></a>
<a class="CoveoTab" data-id="SalesforceDocument" data-caption="Documents" data-expression="@objecttype==(ContentDocument)"></a>
<a class="CoveoTab" data-id="SalesforceLead" data-caption="Leads" data-expression="@objecttype==(Lead)"></a>
<a class="CoveoTab" data-id="SalesforceOpportunity" data-caption="Opportunities" data-expression="@objecttype==(Opportunity)"></a>
<a class="CoveoTab" data-id="SalesforceReport" data-caption="reports" data-expression="@objecttype==(Report)"></a>
<a class="CoveoTab" data-id="SalesforceUser" data-caption="Users" data-expression="@objecttype==(User)"></a>
<a class="CoveoTab" data-id="Salesforce" data-caption="Salesforce" data-expression="@objecttype==(Account, KnowledgeArticleVersion, Case, Contact, FeedItem, ContentDocument, Lead, Opportunity, Report, User) (NOT @sftype==(ContentPost,CollaborationGroupCreated,CreateRecordEvent))"></a>
<a class="CoveoTab" data-id="SalesforceArticle" data-caption="Articles" data-expression="(@objecttype==KnowledgeArticleVersion) OR @sfknowledgearticleid"></a>
