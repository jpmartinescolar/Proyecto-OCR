  <div class="CoveoAnalytics"></div>
  <div class="coveo-tab-section">
    <a class="CoveoTab" data-id="SalesforceArticle" data-caption="Resultados de Búsqueda" data-expression="@objecttype==(Knowledge__kav) AND @Sflanguage=&quot;es&quot; OR (@objecttype==(feeditem))"></a>
  </div>
  <div class="coveo-search-section">
    <div class="CoveoCommunityStateManager"></div>
  </div>
  <div class="coveo-main-section">
    <div class="coveo-facet-column">
      <div class="CoveoFacet" data-title="Manual de Procesos" data-field="@sftipo__C" data-tab="SalesforceArticle" data-number-of-values="16" data-sort-criteria="" data-custom-sort="Introducción, Comercial"></div>
      <div class="CoveoFacet" data-title="Área de Práctica" data-field="@Sfrea_de_Pr_ctica__c" data-number-of-values=""></div>
      <div class="CoveoFacet" data-title="Productos Tecnológicos" data-field="@SfTecnolog_a__c" data-number-of-values=""></div>
    </div>
    <div class="coveo-results-column">
      <div class="CoveoTriggers"></div>
      <div class="CoveoBreadcrumb"></div>
      <div class="CoveoDidYouMean"></div>
      <div class="coveo-results-header">
        <div class="coveo-summary-section">
          <span class="CoveoQuerySummary" data-no-results-found-message="No existen resultados con esta búsqueda. Buscar de nuevo" data-enable-search-tips="false"><div class="coveo-show-if-no-results"></div></span>
          <span class="CoveoQueryDuration"></span>
        </div>
        <div class="coveo-result-layout-section">
          <span class="CoveoResultLayout"></span>
        </div>
        <div class="coveo-sort-section">
          <span class="CoveoSort" data-sort-criteria="date descending,date ascending" data-caption="Última modificación"></span>
          <span class="CoveoSort" data-caption="Visitas" data-sort-criteria="@sfarticletotalviewcount descending,@sfarticletotalviewcount ascending"></span>
          <span class="CoveoSort" data-sort-criteria="relevancy" data-caption="Relevancia"></span><span class="CoveoSort" data-sort-criteria="date descending,date ascending" data-caption="Fecha"></span></div>
      </div>
      <div class="CoveoHiddenQuery"></div>
      <div class="CoveoErrorReport" data-pop-up="false"></div>
      <div class="CoveoResultList" data-layout="list" data-wait-animation="fade" data-auto-select-fields-to-include="true" data-fields-to-include="@sfrea_de_Pr_ctica_especializada__c, @SfDelegaciones__c, @SfClub_de_Innovaci_n__c, @SfDescripci_n__c, @SfType, @objecttype">
