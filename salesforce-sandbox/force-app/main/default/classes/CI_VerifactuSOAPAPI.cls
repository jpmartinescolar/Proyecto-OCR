public class CI_VerifactuSOAPAPI {

    public final static String SOAP_NS = 'http://schemas.xmlsoap.org/soap/envelope/';
    public final static String RESPUESTA_SUMINISTRO_NS = 'https://www2.agenciatributaria.gob.es/static_files/common/internet/dep/aplicaciones/es/aeat/tike/cont/ws/RespuestaSuministro.xsd';
    public final static String SUMINISTRO_INFORMACION_NS = 'https://www2.agenciatributaria.gob.es/static_files/common/internet/dep/aplicaciones/es/aeat/tike/cont/ws/SuministroInformacion.xsd';
    
    /*
    *   @Author         :   Julian Martinez <julian@calibre360.io>
    */
    public static HttpResponse sendSoapRequest(CI_XMLAEAT__c xmlAEATRecord, Attachment xmlVerifactuFileAttachment) {
        Http http = new Http();
        
        HttpRequest request = generateRequest(
            xmlAEATRecord, 
            xmlVerifactuFileAttachment
        );

        CI_CustomLogHelper.addNewLog(
            'save body request - CI_VerifactuAPIBatch.execute',
            request.getBody()
        );

        HttpResponse response = http.send(request);
        CI_CustomLogHelper.saveCurrentCustomLog();

        return response;
    }

    /*
    *   @Author         :   Julian Martinez <julian@calibre360.io>
    */
    private static HttpRequest generateRequest(CI_XMLAEAT__c xmlAEATRecord, Attachment xmlVerifactuFileAttachment) {
        String certif = CI_ConsecutivosFacturasHelper.CONSECUTIVOS_FACTURAS_MAP.get(xmlAEATRecord.CI_EmpresaTitular__c).CI_Certificado__c;

        CI_APIIntegrationConfig__mdt apiConfiguration = CI_APIIntegrationConfigHelper.getMetadata(CI_APIIntegrationConfigHelper.API_INTEGRATION_CONFIG_AEAT);

        String endpoint = apiConfiguration.CI_UseTestingEndpoint__c ? apiConfiguration.CI_APITestURL__c : apiConfiguration.CI_APIBaseURL__c;

        String soapBody = xmlVerifactuFileAttachment.Body.toString();

        HttpRequest request = new HttpRequest();
        
        request.setEndpoint(endpoint);
        request.setMethod('POST');
        request.setHeader('Content-Type', 'text/xml; charset=UTF-8');
        request.setHeader('SOAPAction', ''); // Requerido por algunos servicios SOAP
        request.setClientCertificateName(certif);
        request.setBody(soapBody);

        return request;
    }

    /*
    *   @Author         :   Julian Martinez <julian@calibre360.io>
    */
    public static Map<String, CI_RegistroFacturacion__c> parseAEATResponse(
        Dom.Document responseAsXml, 
        CI_XMLAEAT__c xmlAEATRetrieved, 
        Map<String, CI_RegistroFacturacion__c> registrosFacturacion
        ) {
        Dom.XmlNode root = responseAsXml.getRootElement();
        Dom.xmlNode childNodeBody = root.getChildElement('Body', SOAP_NS);
        Dom.XmlNode childNodeRespuestaRegFactuSistemaFacturacion = childNodeBody.getChildElement('RespuestaRegFactuSistemaFacturacion', RESPUESTA_SUMINISTRO_NS);
        List<Dom.XmlNode> childElements = childNodeRespuestaRegFactuSistemaFacturacion.getChildElements();
        
        String codigoCSV = '';
        
        Integer respuestasSize = childElements.size();
        for (Integer i = 0; i < respuestasSize; i++) {
            Dom.XmlNode childNode = childElements[i];
            
            if (childNode.getName() == 'CSV') {
                codigoCSV = getCSVCode(childNodeRespuestaRegFactuSistemaFacturacion);
            }

            if (childNode.getName() == 'RespuestaLinea') {
                updateRegistrosFacturacionData(childNode, registrosFacturacion);
            }
        }

        if (!String.isBlank(codigoCSV)) {
            xmlAEATRetrieved.CI_CodigoCSV__c = codigoCSV;
        }

        return registrosFacturacion;
    }

    /*
    *   @Author         :   Julian Martinez <julian@calibre360.io>
    */
    public static String getCSVCode(Dom.XmlNode headerNode) {
        Dom.XmlNode childNodeCSV = headerNode.getChildElement('CSV', RESPUESTA_SUMINISTRO_NS);

        String codigoCSV = childNodeCSV.getText();

        return codigoCSV;
    }

    /*
    *   @Author         :   Julian Martinez <julian@calibre360.io>
    */
    public static void updateRegistrosFacturacionData(Dom.XmlNode childNodeRespuestaLinea, Map<String, CI_RegistroFacturacion__c> registrosFacturacion) {
        String codigoError;
        String descripcionError;
        
        String numSerieFactura = getNumSerieFactura(childNodeRespuestaLinea);

        Dom.XmlNode childNodeEstadoRegistro = childNodeRespuestaLinea.getChildElement('EstadoRegistro', RESPUESTA_SUMINISTRO_NS);
        
        String estadoRegistro = childNodeEstadoRegistro.getText();
        
        if (estadoRegistro.equalsIgnoreCase('Incorrecto') || estadoRegistro.equalsIgnoreCase('AceptadoConErrores')) {
            Dom.XmlNode childNodeCodigoErrorRegistro = childNodeRespuestaLinea.getChildElement('CodigoErrorRegistro', RESPUESTA_SUMINISTRO_NS);
            Dom.XmlNode childNodeDescripcionErrorRegistro = childNodeRespuestaLinea.getChildElement('DescripcionErrorRegistro', RESPUESTA_SUMINISTRO_NS);

            codigoError = childNodeCodigoErrorRegistro.getText();
            descripcionError = childNodeDescripcionErrorRegistro.getText();
        }

        CI_RegistroFacturacion__c registroFacturacion = registrosFacturacion.get(numSerieFactura);

        if (registroFacturacion != NULL) {
            registroFacturacion.CI_EstadoRegistroAEAT__c = estadoRegistro;
            registroFacturacion.CI_CodigoErrorAEAT__c = codigoError != NULL ? codigoError : NULL;
            registroFacturacion.CI_DescripcionCodigoErrorAEAT__c = descripcionError != NULL ? descripcionError : NULL;
            registroFacturacion.CI_RegistroRechazado__c = estadoRegistro.equalsIgnoreCase('Incorrecto') ? TRUE : FALSE;
            registroFacturacion.CI_Procesado__c = TRUE;
        }
    }

    /*
    *   @Author         :   Julian Martinez <julian@calibre360.io>
    */
    public static String getNumSerieFactura(Dom.XmlNode headerNode) {
        Dom.XmlNode childNodeIDFactura = headerNode.getChildElement('IDFactura', RESPUESTA_SUMINISTRO_NS);
        Dom.XmlNode childNodeNumSerieFactura = childNodeIDFactura.getChildElement('NumSerieFactura', SUMINISTRO_INFORMACION_NS);

        String numSerieFactura = childNodeNumSerieFactura.getText();

        return numSerieFactura;
    }

