    public static CI_RegistroVerifactuWrapper.RegistroVerifactuBase fillXMLAEATWrapper(CI_RegistroVerifactuWrapper.RegistroVerifactuBase wrapperVerifactuBase, List<CI_RegistroFacturacion__c> registrosFacturacionRetrieved) {
        Integer registrosFacturacionRetrievedSize = registrosFacturacionRetrieved.size();
        for (Integer i = 0; i < registrosFacturacionRetrievedSize; i++) {
            CI_RegistroFacturacion__c regFacturacion = registrosFacturacionRetrieved[i];

            CI_RegistroVerifactuWrapper.RegistroAlta regVerifactuAltaWrapper;
            CI_RegistroVerifactuWrapper.RegistroAnulacion regVerifactuAnulacionWrapper;

            if (!regFacturacion.CI_AnularRegistroDeAltaAnterior__c) {
                regVerifactuAltaWrapper = CI_XMLAEATGenerator.getRegistroFacturacionAltaWrapper(
                    regFacturacion, 
                    wrapperVerifactuBase
                );
            }
            else if (regFacturacion.CI_AnularRegistroDeAltaAnterior__c) {
                regVerifactuAnulacionWrapper = CI_XMLAEATGenerator.getRegistroFacturacionAnulacionWrapper(
                    regFacturacion, 
                    wrapperVerifactuBase
                );
            }

            CI_RegistroVerifactuWrapper.RegistroFactura regVerifactuFacturaWrapper = new CI_RegistroVerifactuWrapper.RegistroFactura();
            regVerifactuFacturaWrapper.RegistroAlta = regVerifactuAltaWrapper != NULL ? regVerifactuAltaWrapper : NULL;
            regVerifactuFacturaWrapper.RegistroAnulacion = regVerifactuAnulacionWrapper != NULL ? regVerifactuAnulacionWrapper : NULL;

            if (wrapperVerifactuBase.RegistroFactura.isEmpty()) {
                wrapperVerifactuBase.RegistroFactura = new List<CI_RegistroVerifactuWrapper.RegistroFactura>{
                    regVerifactuFacturaWrapper
                };
            } else {
                wrapperVerifactuBase.RegistroFactura.add(regVerifactuFacturaWrapper);
            }
        }

        return wrapperVerifactuBase;
    }

