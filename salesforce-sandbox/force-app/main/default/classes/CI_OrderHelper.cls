    //Estado de facturación
    public static final String STATUS_INVOICE_PENDIENTE = 'Pendiente';
    public static final String STATUS_INVOICE_FACTURADO = 'Facturado';

    //Empresa titular
    public static final String EMPRESA_TITULAR_CENTRO_INNOV = 'Centro de Innovación de Despachos y Pymes, S.L';
