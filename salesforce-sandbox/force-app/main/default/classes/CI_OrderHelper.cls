    /*
    *   @Author         :   Julian Martinez <julian@calibre360.io>
    *   @Description    :   Actualiza los pedidos que se han facturado
    */
    public static void updateBilledOrders(Set<Id> sOrders, Map<Id, Id> invoiceGeneratedIdsByOrderBilledIds) {
        List<Order> lOrdersToUpdate = new List<Order>();

        lOrdersToUpdate = [
            SELECT Id, 
                Estado_Facturaci_n__c 
            FROM Order 
            WHERE Id IN: sOrders
        ];

        if (!lOrdersToUpdate.isEmpty()) {
            updateBilledOrdersData(lOrdersToUpdate, invoiceGeneratedIdsByOrderBilledIds);

            update lOrdersToUpdate;
        }
    }

    /*
    *   @Author         :   Julian Martinez <julian@calibre360.io>
    *   @Description    :   Actualiza la información de los pedidos que se han facturado
    */
    public static void updateBilledOrdersData(List<Order> ordersToUpdateData, Map<Id, Id> invoiceGeneratedIdsByOrderBilledIds) {
        for (Order iOrder : ordersToUpdateData) {
            Id invoiceId = invoiceGeneratedIdsByOrderBilledIds.get(iOrder.Id);

            iOrder.Estado_Facturaci_n__c = CI_OrderHelper.STATUS_INVOICE_FACTURADO;
            iOrder.Factura__c = invoiceId != NULL ? invoiceId : NULL;
        }
    }

