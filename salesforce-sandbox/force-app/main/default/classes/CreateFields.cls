/**
 * Converts structured JSON generated by a prompt into
 * Datos_estructurados__c records related to a deed.
 */
public class CreateFields {

    /**
     * Creates one structured-data record for every item in the JSON array.
     * Each item is expected to contain the string keys campo and valor.
     *
     * @param jsonBody JSON array, optionally enclosed in a Markdown code fence.
     * @param recordId Id of the parent Deed__c record.
     */
    public static void fields(String jsonBody, String recordId) {
        
        String jsonPayLoad = jsonBody;
        // Prompt Builder can return JSON enclosed in Markdown code fences.
        jsonPayLoad = jsonPayLoad.removeStart('```json');
        jsonPayLoad = jsonPayLoad.removeEnd('```');
        
        Datos_estructurados__c  dato = new Datos_estructurados__c();
       	List<Datos_estructurados__c> datos = new List< Datos_estructurados__c>();
		// Deserialize the array without requiring a dedicated wrapper class.
		List<Object> payload =(List<Object>) JSON.deserializeUntyped(jsonPayLoad);
       
        // Map campo to the record name and valor to the stored field value.
        for (Object item : payload) {
            
            dato = new Datos_estructurados__c();
            
            Map<String, Object> row = (Map<String, Object>) item;
            dato.Name = (String)row.get('campo');    
            dato.Valor__c = (String)row.get('valor');
     
 			dato.Escritura__c = recordId;
            datos.add(dato);
        }
		
		// Insert all generated fields in one DML operation.
		insert datos;
        
        
    }
    
    
    
}