global class CI_PrepareVerifactuBatch implements Database.Batchable<sObject>, Database.Stateful, Database.AllowsCallouts {
    String query;
    Integer batchSize;
    Boolean isProcessActive;
    public Map<String, String> mEmpresaByNIF;

    global CI_PrepareVerifactuBatch() {
        query = CI_ProcessControlHelper.getControlProcess(CI_ProcessControlHelper.PREPARE_VERIFACTU_AEAT).CI_QueryBatch__c;
        batchSize = Integer.valueOf(CI_ProcessControlHelper.getControlProcess(CI_ProcessControlHelper.PREPARE_VERIFACTU_AEAT).CI_BatchSize__c);
        isProcessActive = CI_ProcessControlHelper.getControlProcess(CI_ProcessControlHelper.PREPARE_VERIFACTU_AEAT).CI_IsActive__c;

        this.mEmpresaByNIF = CI_ConsecutivosFacturasHelper.VERIFACTU_EMPRESA_BY_NIF_MAP;
    }

    global Database.QueryLocator start(Database.BatchableContext BC) {
        return Database.getQueryLocator(query);
    }
    //El size del batch será 1
    global void execute(Database.BatchableContext BC, List<sObject> scope) {
        if (!isProcessActive) {
            return;
        }
        List<Facturas__c> lInvoices         = (List<Facturas__c>)scope;
        Set<Id> sIds                        = new Set<Id>();
        Set<Id> sIdProcess                  = new Set<Id>();
        Boolean flagError                   = false;
        
        Map<String, Facturas__c> mInvoicesByInvoiceNumber       = new Map<String, Facturas__c>();
        Map<String, Facturas__c> mInvoicesByBeforeInvoiceNumber = new Map<String, Facturas__c>();
        
        for(Facturas__c iInv: lInvoices){
            sIdProcess.add(iInv.Id);
            //Sólo preparar para Verifactu facturas que se envíen a Verifactu 
            if(mEmpresaByNIF.containsKey(iInv.CIF_emisor__c)){
                sIds.add(iInv.Id);
                //Proceso de generción del QR de factura
                try {
                    String generatedQRId = CI_APIQRfyHelper.generateQRImage(iInv.N_factura__c, iInv.CI_URLVerifactuAEAT__c);

                    if (generatedQRId != NULL) {
                        Blob qrImageData = CI_APIQRfyHelper.retrieveQRImage(generatedQRId);
                        
                        CI_APIQRfyHelper.attachQRImageToInvoice(iInv, qrImageData);
                    }
                }
                catch(Exception e) {
                    flagError = true;
                    String data = 'STACK TRACE:\n' + e.getStackTraceString() + '\nMESSAGE:\n' + e.getMessage() + '\nLine:\n' + e.getLineNumber();

                    CI_CustomLogHelper.addNewLog(
                        'CI_PrepareVerifactuBatch.execute - Asignar QR',
                        data
                    );

                    CI_CustomLogHelper.saveCurrentCustomLog();
                }
                //Resto de Procesos
                if(!flagError){
                    Savepoint checkPoint = Database.setSavepoint();
                    try{
                        if(!iInv.CI_PrimeraFacturaAEAT__c){
                            //Mapa de Factura x Número de factura
                            mInvoicesByInvoiceNumber.put(
                                iInv.N_factura__c,
                                iInv
                            );

                            //Mapa de Factura x Número de factura anterior
                            mInvoicesByBeforeInvoiceNumber.put(
                                CI_InvoiceHelper.getLastInvoiceNumber(iInv.N_factura__c),
                                iInv
                            );
                            //Asignar Factura anterior
                            CI_InvoiceHelper.updateBeforeInvoice(mInvoicesByInvoiceNumber, mInvoicesByBeforeInvoiceNumber);
                        }
                        
                        //Asignar hash Verifactu a factura
                        CI_InvoiceHelper.setHashKey(sIds);
                        
                        //Marcar facturas como preparadas para Verifactu
                        CI_InvoiceHelper.setInvoiceAsVerifactuPrepared(sIds);
                    }
                    catch(Exception e) {
                        Database.rollback(checkPoint);
                        
                        flagError = true;
                        String data = 'STACK TRACE:\n' + e.getStackTraceString() + '\nMESSAGE:\n' + e.getMessage() + '\nLine:\n' + e.getLineNumber();

                        CI_CustomLogHelper.addNewLog(
                            'CI_PrepareVerifactuBatch.execute',
                            data
                        );

                        CI_CustomLogHelper.saveCurrentCustomLog();
                    }
                }
            }
        }
        //Marcar facturas como procesadas y que no vuelva a entrar en este proceso
        if(!flagError){
            CI_InvoiceHelper.setInvoiceAsProceced(sIdProcess);
        }
    }

    global void finish(Database.BatchableContext BC) {
        CI_GenerarXMLAEATBatch.searchAndProcess();

        CI_CustomLogHelper.addNewLog(
            'CI_PrepareVerifactuBatch.finish',
            'Success'
        );
        
        CI_CustomLogHelper.saveCurrentCustomLog();
    }

