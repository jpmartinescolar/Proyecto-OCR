    */
    public static List<CI_CustomLog__c> currentCustomLogs {
		get {
			if (currentCustomLogs == NULL) {
				currentCustomLogs = new List<CI_CustomLog__c>();
			}

			return currentCustomLogs;
		}
		set;
	}

    /*
    *   @Author         :   Julian Martinez <julian@calibre360.io>
    */
    public static void saveCurrentCustomLog() {
		insert currentCustomLogs;
		currentCustomLogs = NULL;
	}

    /*
    *   @Author         :   Julian Martinez <julian@calibre360.io>
    */
    public static void addNewLog(String whereP, String dataP) {
		currentCustomLogs.add(
            new CI_CustomLog__c(
                CI_Where__c = whereP,
                CI_Data__c = dataP
            )
        );
	}

  /*
    *   @Author         :   José Ernesto <jose@calibre360.io>
    */
    public static void addNewLog(String whereP, String dataP, String idXML) {
		currentCustomLogs.add(
            new CI_CustomLog__c(
                CI_Where__c = whereP,
                CI_Data__c = dataP,
                CI_XMLAEAT__c = idXML
            )
        );
	}

