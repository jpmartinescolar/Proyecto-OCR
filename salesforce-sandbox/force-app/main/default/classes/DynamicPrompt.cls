/**
 * Executes a Prompt Builder template through Connect API and converts the
 * generated JSON response into structured deed fields.
 */
public with sharing class DynamicPrompt {

    /**
     * Executes a prompt template using file, action, deed, and Contact inputs.
     *
     * @param contentDocumentId Id of the file supplied to the prompt.
     * @param templateAPIName API name of the active Prompt Builder template.
     * @param actionId Id of the configured AI action or skill.
     * @param deedId Id of the deed used for grounding and generated fields.
     * @param contactId Id of the Contact used for grounding.
     * @return Raw text generated by the prompt template.
     */
    @AuraEnabled
    public static String executePromptTemplate(String contentDocumentId, String templateAPIName, String actionId, String deedId, String contactId) {
        // Each prompt input must be wrapped as an object containing its Id.
        Map<String, String> fileInput = new Map<String, String>();
        Map<String, String> actionInput = new Map<String, String>();
        Map<String, String> contactInput = new Map<String, String>();
        Map<String, String> recordInput = new Map<String, String>();
        Map<String, ConnectApi.WrappedValue> inputParams = new Map<String, ConnectApi.WrappedValue>();
        
        ConnectApi.WrappedValue fileWrapped = new ConnectApi.WrappedValue();
        ConnectApi.WrappedValue actionWrapped = new ConnectApi.WrappedValue();
        ConnectApi.WrappedValue contactWrapped = new ConnectApi.WrappedValue();
        ConnectApi.WrappedValue recordWrapped = new ConnectApi.WrappedValue();
        
        actionInput.put('id',actionId);
        actionWrapped.value = actionInput;
        
        fileInput.put('id', contentDocumentId);
        fileWrapped.value = fileInput;
	
        contactInput.put('id', contactId);
        contactWrapped.value = contactInput; 
        
        recordInput.put('id', deedId);
        recordWrapped.value = recordInput; 
        
        inputParams.put('Input:File', fileWrapped);
        inputParams.put('Input:Acciones', actionWrapped);
        inputParams.put('Input:Contact', contactWrapped);
        inputParams.put('Input:Deed', recordWrapped);
       
        // Configure the generation request. Preview is disabled so the
        // resolved prompt is submitted to the configured language model.
        ConnectApi.EinsteinPromptTemplateGenerationsInput executeTemplateInput = new ConnectApi.EinsteinPromptTemplateGenerationsInput();
        executeTemplateInput.additionalConfig = new ConnectApi.EinsteinLlmAdditionalConfigInput();
        executeTemplateInput.additionalConfig.applicationName = 'PromptBuilderPreview';
        executeTemplateInput.isPreview = false;
        executeTemplateInput.inputParams = inputParams;

        try {
            // Execute the template and use its first generated response.
            ConnectApi.EinsteinPromptTemplateGenerationsRepresentation generationsOutput = ConnectApi.EinsteinLLM.generateMessagesForPromptTemplate(
                templateAPIName,
                executeTemplateInput
            );
            ConnectApi.EinsteinLLMGenerationItemOutput response = generationsOutput.generations[0];
            System.debug('response'+response.text);
            // The prompt returns structured JSON that is persisted as child
            // records of the deed.
            CreateFields.fields(response.text,deedId);
            return response.text;
        } catch (Exception e) {
            // Preserve the original exception for the caller after logging it.
            System.debug(e.getStackTraceString());
            System.debug(e.getMessage());
            throw e;
        }
    }
}