     *   @Author             :   José Ernesto <jose@calibre360.io>
     *   @Created            :   22 Nov 2025
     *   @Description        :   Crear llave del hash
     */
    public static String generateHashKey(
        Facturas__c invoice,
        String fechaExpedicion, 
        String huellaPrevia, 
        String fechaHoraHusoRegistro
    ) {
        // String fechaExpedicionFormatted = fechaExpedicion.format('dd-MM-yyyy');
        // String fechaHoraHusoFormatted = fechaHoraHusoRegistro.format('yyyy-MM-dd\'T\'HH:mm:ssXXX');
        
        String key = getStringHash(
            invoice,
            fechaExpedicion, 
            huellaPrevia, 
            fechaHoraHusoRegistro
        );
        
        Blob digest = Crypto.generateDigest('SHA-256', Blob.valueOf(key));
        String hash = EncodingUtil.convertToHex(digest).toUpperCase();

        return hash;
    }
