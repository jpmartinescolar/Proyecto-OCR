    /*
    *   @Author         :   Julian Martinez <julian@calibre360.io>
    */
    public static Facturas__c getBusinessUnitLastInvoice(String invoiceNumber, String cif) {
        String lastInvoiceNumber = CI_InvoiceHelper.getLastInvoiceNumber(invoiceNumber);
        system.debug('lastInvoiceNumber::: ' + lastInvoiceNumber);
        List<Facturas__c> lastInvoices = [
            SELECT Id, 
                N_Factura__c, 
                CIF_emisor__c, 
                CI_HashAEAT__c 
            FROM Facturas__c 
            WHERE CIF_emisor__c =: cif 
            AND N_Factura__c =: lastInvoiceNumber
        ];

        return lastInvoices[0];
    }

