global class CI_GenerateRegFacturacionFlow {
    @InvocableMethod(label='Generar registro de facturación AEAT' description='Genera un nuevo registro de facturación para su envío a la AEAT.')
    public static List<string> startProcessFromFlow(List<FlowInputs> inputParams) {
        List<string> flowResponse = new List<string>();

        FlowInputs inputParam = inputParams[0];

        List<CI_RegistroFacturacion__c> previousRecords = new List<CI_RegistroFacturacion__c>([
            SELECT Id, 
                CI_RegistroAnterior__c 
            FROM CI_RegistroFacturacion__c 
            WHERE CI_FacturaEmitida__c =: inputParam.invoice.CI_FacturaAnterior__c
        ]);

        CI_RegistroFacturacion__c previousRecord = !previousRecords.isEmpty() ? previousRecords[0] : NULL;

        CI_RegistroFacturacion__c newRegFacturacion = CI_RegistroFacturacionHelper.createRegistroFacturacion(inputParam.invoice, previousRecord, inputParam.xmlAEAT);

        if (newRegFacturacion != NULL) {
            insert newRegFacturacion;
        }

        return flowResponse;
    }

    global class FlowInputs {
        @InvocableVariable
        public Facturas__c invoice;

        @InvocableVariable
        public CI_XMLAEAT__c xmlAEAT;
    }

