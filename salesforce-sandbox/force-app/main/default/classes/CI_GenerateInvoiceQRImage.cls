global class CI_GenerateInvoiceQRImage {
    
    @InvocableMethod(label='Generar QR de la factura' description='Solicita la generación del QR de Verifactu y lo adjunta a la factura')
    public static List<string> startProcessFromFlow(List<FlowInputs> inputParams) {
        if (!CI_ProcessControlHelper.getControlProcess(CI_ProcessControlHelper.GENERATE_QR_VERIFACTU).CI_IsActive__c) {
            return new List<string>();
        }
        
        List<string> flowResponse = new List<string>();

        Facturas__c invoiceToGenerateQR = [
            SELECT Id, 
                N_factura__c, 
                CI_URLVerifactuAEAT__c 
            FROM Facturas__c 
            WHERE Id =: inputParams[0].idFactura 
            LIMIT 1
        ];

        String generatedQRId = CI_APIQRfyHelper.generateQRImage(invoiceToGenerateQR.N_factura__c, invoiceToGenerateQR.CI_URLVerifactuAEAT__c);

        if (generatedQRId != NULL) {
            Blob qrImageData = CI_APIQRfyHelper.retrieveQRImage(generatedQRId);
            
            CI_APIQRfyHelper.attachQRImageToInvoice(invoiceToGenerateQR, qrImageData);

            flowResponse.add('QR adjuntado a la factura validada.');
        } else {
            flowResponse.add('Error: no se ha podido generar el QR para la factura validada.');
        }

        return flowResponse;
    }

    global class FlowInputs {
        @InvocableVariable
        public String idFactura;
    }

