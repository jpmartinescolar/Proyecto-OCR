    public static Boolean isCountryCode(String iText){
        if (iText != NULL) {
            String code = iText.substring(0,2);
            String countries  = 'AD:AE:AF:AG:AI:AL:AM:AN:AO:AQ:AR:AS:AT:AU:AW:AX:AZ:';
                countries += 'BA:BB:BD:BE:BF:BG:BH:BI:BJ:BL:BM:BN:BO:BR:BS:BT:BV:';
                countries += 'BW:BY:BZ:CA:CC:CD:CF:CG:CH:CI:CK:CL:CM:CN:CO:CR:CU:';
                countries += 'CV:CX:CY:CZ:DE:DJ:DK:DM:DO:DZ:EC:EE:EG:EH:ER:ES:ET:';
                countries += 'FI:FJ:FK:FM:FO:FR:GA:GB:GD:GE:GF:GH:GI:GL:GM:GN:GP:';
                countries += 'GQ:GR:GS:GT:GU:GW:GY:HK:HM:HN:HR:HT:HU:ID:IE:IL:IM:';
                countries += 'IN:IO:IQ:IR:IS:IT:JE:JM:JO:JP:KE:KG:KH:KI:KM:KN:KP:';
                countries += 'KR:KW:KY:KZ:LA:LB:LC:LI:LK:LR:LS:LT:LU:LV:LY:MA:MC:';
                countries += 'MD:ME:MF:MG:MH:MK:ML:MM:MN:MO:MP:MQ:MR:MS:MT:MU:MV:';
                countries += 'MW:MX:MY:MZ:NA:NC:NE:NF:NG:NI:NL:NO:NP:NR:NU:NZ:OM:';
                countries += 'PA:PE:PF:PG:PH:PK:PL:PM:PN:PR:PS:PT:PW:PY:QA:RE:RO:';
                countries += 'RS:RU:RW:SA:SB:SC:SD:SE:SG:SH:SI:SJ:SK:SL:SM:SN:SO:';
                countries += 'SR:ST:SV:SY:SZ:TC:TD:TF:TG:TH:TJ:TK:TL:TM:TN:TO:TR:';
