    /*
    *   @Author         :   Julian Martinez <julian@calibre360.io>
    */
    public static Boolean checkRegularExpresion(String iData, String iRegularExp){
        try{
            Pattern iPattern = Pattern.compile(iRegularExp);
            Matcher iMatcher = iPattern.matcher(iData);

            return iMatcher.matches();
        }
        catch(Exception e){
            return FALSE;
        }
    }

