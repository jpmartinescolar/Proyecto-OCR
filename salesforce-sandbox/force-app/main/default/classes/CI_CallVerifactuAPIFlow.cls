global class CI_CallVerifactuAPIFlow {
    
    @InvocableMethod(label='Enviar XML a la AEAT' description='Envía el XML AEAT al servicio Verifactu de Hacienda.')
    public static List<string> startProcessFromFlow(List<FlowInputs> inputParams) {
        List<string> flowResponse = new List<string>();

        FlowInputs inputParam = inputParams[0];

        List<CI_RegistroFacturacion__c> registrosFacturacion = [
            SELECT Id, 
                CI_NumSerieFactura__c 
            FROM CI_RegistroFacturacion__c 
            WHERE CI_XMLAEAT__c =: inputParam.xmlAEAT.Id
        ];

        Map<String, CI_RegistroFacturacion__c> registrosFacturacionByNumFactura = new Map<String, CI_RegistroFacturacion__c>();

        Integer registrosFacturacionSize = registrosFacturacion.size();
        for (Integer i = 0; i < registrosFacturacionSize; i++) {
            CI_RegistroFacturacion__c registroFacturacion = registrosFacturacion[i];

            registrosFacturacionByNumFactura.put(registroFacturacion.CI_NumSerieFactura__c, registroFacturacion);
        }

        Attachment xmlVerifactu = [
            SELECT Id, 
                ParentId, 
                Body 
            FROM Attachment 
            WHERE ParentId =: inputParam.xmlAEAT.Id 
            LIMIT 1
        ];

        if (xmlVerifactu != NULL) {
            HttpResponse response = CI_VerifactuSOAPAPI.sendSoapRequest(inputParam.xmlAEAT, xmlVerifactu);

            String logXmlResponse = '';

            if (response.getStatusCode() == 200) {
                Dom.Document responseAsXml = response.getBodyDocument();

                logXmlResponse = response.getBody();
                System.debug('logXmlResponse::: ' + logXmlResponse);

                Map<String, CI_RegistroFacturacion__c> registrosToUpdate = CI_VerifactuSOAPAPI.parseAEATResponse(
                    responseAsXml, 
                    inputParam.xmlAEAT, 
                    registrosFacturacionByNumFactura
                );

                if (registrosToUpdate != NULL) {
                    update registrosToUpdate.values();
                }

                inputParam.xmlAEAT.CI_EnviadoHacienda__c = TRUE;

                update inputParam.xmlAEAT;

                CI_CustomLogHelper.addNewLog(
                    'CI_CallVerifactuAPIFlow.startProcessFromFlow',
                    response.getBody()
                );
            } else {
                CI_CustomLogHelper.addNewLog(
                    'CI_CallVerifactuAPIFlow.startProcessFromFlow',
                    response.getBody()
                );
            }

            CI_CustomLogHelper.saveCurrentCustomLog();
        }

        return flowResponse;
    }

    global class FlowInputs {
        @InvocableVariable
        public CI_XMLAEAT__c xmlAEAT;
    }

