    @AuraEnabled
    public static List<Order> getOrdersData(String empresaName){
        List<Order> lOrders;

        try {
            if(empresaName != null){
                lOrders = new List<Order>([
                    SELECT Id, 
                        Name, 
                        Status, 
                        EffectiveDate,
                        Origen_del_pedido__c,
                        OrderNumber, 
                        TotalAmount, 
                        Estado_Facturaci_n__c, 
                        AccountId, 
                        Empresa_Titular__c, 
                        CI_NombreDeCliente__c, 
                        Grupo_empresarial__c
                    FROM Order 
                    WHERE Estado_Facturaci_n__c =:CI_OrderHelper.STATUS_INVOICE_PENDIENTE
                    AND Empresa_Titular__c =:empresaName 
                    AND Validaci_n__c =: 'Si'
                ]);
            }
            else{
                lOrders = new List<Order>([
                    SELECT Id, 
                        Name, 
                        Status, 
                        EffectiveDate,
                        Origen_del_pedido__c,
                        OrderNumber, 
                        TotalAmount, 
                        Estado_Facturaci_n__c, 
                        AccountId, 
                        Empresa_Titular__c, 
                        CI_NombreDeCliente__c, 
                        Grupo_empresarial__c
                    FROM Order 
                    WHERE Estado_Facturaci_n__c =:CI_OrderHelper.STATUS_INVOICE_PENDIENTE 
                    AND Validaci_n__c =: 'Si'
                ]);
            }

            return lOrders;
        } catch(Exception e) {
            throw new AuraHandledException('Error retrieving Orders: ' + e.getMessage());
        }
    }

