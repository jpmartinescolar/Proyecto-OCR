global class CI_GenerateXMLAEATFileFlow {
    
    @InvocableMethod(label='Generar fichero XML AEAT' description='Genera un fichero XML AEAT para enviar al servicio de Verifactu.')
    public static List<string> startProcessFromFlow(List<FlowInputs> inputParams) {
        List<string> flowResponse = new List<string>();

        FlowInputs inputParam = inputParams[0];

        List<CI_RegistroFacturacion__c> registrosFacturacion = new List<CI_RegistroFacturacion__c>([
            SELECT Id, 
                SystemModstamp, 
                CI_TipoFacturaAuto__c, 
                CI_IdEmisorFactura__c, 
                CI_NumSerieFactura__c, 
                CI_FechaExpedicionFactura__c, 
                CI_FechaExpedicionFacturaAEAT__c,
                CI_FechaHoraHusoGenRegistroAEAT__c,
                CI_BaseImponible__c, 
                CI_CuotaTotal__c, 
                CI_HashFactura__c, 
                CI_NombreRazonEmisor__c, 
                CI_TipoFacturaAEAT__c, 
                CI_ImporteTotal__c, 
                CI_NombreCliente__c, 
                CI_CIFCliente__c, 
                CI_PrimerRegistroPresentadoAEAT__c, 
                CI_RegistroAnterior__c, 
                CI_RegistroAnterior__r.CI_IdEmisorFactura__c, 
                CI_RegistroAnterior__r.CI_NumSerieFactura__c, 
                CI_RegistroAnterior__r.CI_FechaExpedicionFactura__c, 
                CI_RegistroAnterior__r.CI_HashFactura__c 
            FROM CI_RegistroFacturacion__c 
            WHERE CI_XMLAEAT__c =: inputParam.xmlAEAT.Id
        ]);


        try {
            if (!registrosFacturacion.isEmpty()) {
                CI_RegistroVerifactuWrapper.RegistroVerifactuBase wrapperVerifactuBase = CI_XMLAEATGenerator.getRegistroVerifactuBaseWrapper(inputParam.xmlAEAT);
            
                CI_GenerateXMLAEATFileBatchHelper.fillXMLAEATWrapper(wrapperVerifactuBase, registrosFacturacion);

                CI_XMLAEATGenerator.generateXMLFile(inputParam.xmlAEAT, wrapperVerifactuBase);

                flowResponse.add('OK');
            }
        } catch (Exception e) {
            String data = 'STACK TRACE:\n' + e.getStackTraceString() + '\nMESSAGE:\n' + e.getMessage() + '\nLine:\n' + e.getLineNumber();

            CI_CustomLogHelper.addNewLog(
                'CI_GenerateXMLAEATFileFlow.startProcessFromFlow',
                data
            );

            CI_CustomLogHelper.saveCurrentCustomLog();

            flowResponse.add(data);
        }

        return flowResponse;
    }

    global class FlowInputs {
        @InvocableVariable
        public CI_XMLAEAT__c xmlAEAT;
    }

