global class CI_AssignInvoiceNumberFlow {
    @InvocableMethod(label='Asignar numero de factura' description='Asignar número de factura')
    public static List<string> startProcessFromFlow(List<FlowInputs> inputParams) {
        List<string> flowResponse                   = new List<string>();

        System.savePoint sp = Database.setSavePoint();
        try {
            Facturas__c invoiceToAssignNumber = [
                SELECT Id, 
                    Empresa_Titular__c, 
                    CI_TipoDeFactura__c 
                FROM Facturas__c 
                WHERE Id =: inputParams[0].idFactura 
                LIMIT 1
            ];

            if (CI_ConsecutivosFacturasHelper.CONSECUTIVOS_FACTURAS_MAP.get(invoiceToAssignNumber.Empresa_Titular__c) != NULL) {
                if (invoiceToAssignNumber.CI_TipoDeFactura__c == 'Normal') {
                    invoiceToAssignNumber.N_factura__c = CI_ConsecutivosFacturasHelper.getNormalInvoiceNumber(invoiceToAssignNumber.Empresa_Titular__c);
                } else {
                    invoiceToAssignNumber.N_factura__c = CI_ConsecutivosFacturasHelper.getAbonoInvoiceNumber(invoiceToAssignNumber.Empresa_Titular__c);
                }

                if (invoiceToAssignNumber.N_factura__c != NULL) {
                    CI_ConsecutivosFacturasHelper.updateRecords(
                        invoiceToAssignNumber.CI_TipoDeFactura__c
                    );

                    update invoiceToAssignNumber;

                    flowResponse.add(invoiceToAssignNumber.N_factura__c);
                }
            } else {
                flowResponse.add('Error');
            }
        } catch (Exception e) {
            Database.rollback(sp);
        }

        return flowResponse;
    }

    global class FlowInputs {
        @InvocableVariable
        public String idFactura;
    }

