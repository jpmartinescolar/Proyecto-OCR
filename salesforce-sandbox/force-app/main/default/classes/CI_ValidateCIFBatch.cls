global class CI_ValidateCIFBatch implements Database.Batchable<sObject> {
    String query;

    global CI_ValidateCIFBatch() {
        query = 'SELECT id, CIF__c FROM Account order by CreatedDate desc';
    }

    global Database.QueryLocator start(Database.BatchableContext BC) {
        return Database.getQueryLocator(query);
    }
    //El size del batch será 1
    global void execute(Database.BatchableContext BC, List<sObject> scope) {
        List<Account> lAccounts         = (List<Account>)scope;
        
        List<Account> lAccountToUpdate  = new List<Account>();
        Id idAcc;
        String cif;

        try {
            for(Account iAcc: lAccounts){
                
                Boolean result = CI_CIFValidator.isValidSpanishId(iAcc.CIF__c);

                if(!result){
                    iAcc.CI_CIFInvalido__c = true;
                }
                lAccountToUpdate.add(iAcc);

                idAcc   = iAcc.Id;
                cif     = iAcc.CIF__c;
            }

            if(!lAccountToUpdate.isEmpty()){
                update lAccountToUpdate;
            }
        }
        catch(Exception e) {
            String data = 'STACK TRACE:\n' + e.getStackTraceString() + '\nMESSAGE:\n' + e.getMessage() + '\nLine:\n' + e.getLineNumber();

            CI_CustomLogHelper.addNewLog(
                'CI_ValidateCIFBatch.execute -> Id: ' + idAcc + 'CI_ValidateCIFBatch.execute -> CIF: ' + cif,
                data
            );

            CI_CustomLogHelper.saveCurrentCustomLog();
        }
    }

    global void finish(Database.BatchableContext BC) {
        //Database.executeBatch(new CI_ValidateCIFBatch(), 1);
    }

