public class CI_APIQRfyHelper {
    
    /*
    *	Author: Julián Martínez Cordones <julian@calibre360.io>
    */
    public static String generateQRImage(String invoiceNumber, String qrURL) {
        String generatedQRId;
        
        CI_APIIntegrationConfig__mdt apiConfiguration = CI_APIIntegrationConfigHelper.getMetadata(CI_APIIntegrationConfigHelper.API_INTEGRATION_CONFIG_QRFY);
        
        String requestBody = CI_APIQRfyHelper.generateRequestBody(invoiceNumber, qrURL);

        HttpRequest request = new HttpRequest();
        request.setEndpoint(apiConfiguration.CI_APIBaseURL__c + '/qrs');
        request.setMethod('POST');
        request.setHeader('Content-Type', 'application/json');
        request.setHeader('API-KEY', apiConfiguration.CI_APIKey__c);
        request.setBody(requestBody);

        HttpResponse response = new Http().send(request);

        if (response.getStatusCode() == 200) {
            String responseBody = response.getBody();

            GenerateQRResponseWrapper responseWrapper = (GenerateQRResponseWrapper) JSON.deserialize(responseBody, GenerateQRResponseWrapper.class);

            generatedQRId = String.valueOf(responseWrapper.ids[0]);
        }

        return generatedQRId;
    }

    /*
    *	Author: Julián Martínez Cordones <julian@calibre360.io>
    */
    public static Blob retrieveQRImage(String generatedQRId) {
        Blob qrImageData;

        CI_APIIntegrationConfig__mdt apiConfiguration = CI_APIIntegrationConfigHelper.getMetadata(CI_APIIntegrationConfigHelper.API_INTEGRATION_CONFIG_QRFY);

        HttpRequest request = new HttpRequest();
        request.setEndpoint(apiConfiguration.CI_APIBaseURL__c + '/qrs/' + generatedQRId + '/png');
        request.setMethod('GET');
        request.setHeader('API-KEY', apiConfiguration.CI_APIKey__c);

        HttpResponse response = new Http().send(request);

        if (response.getStatusCode() == 200) {
            qrImageData = response.getBodyAsBlob();
        }

        return qrImageData;
    }

    /*
    *	Author: Julián Martínez Cordones <julian@calibre360.io>
    */
    public static void attachQRImageToInvoice(Facturas__c invoice, Blob qrImageData) {
        ContentVersion cv = new ContentVersion();
        cv.Title = invoice.N_factura__c + ' - QR';
        cv.PathOnClient = invoice.N_factura__c + '-QR.png';
        cv.VersionData = qrImageData;
        insert cv;

        ContentDocumentLink cdl = new ContentDocumentLink();
        
        cdl.ContentDocumentId = [
            SELECT ContentDocumentId 
            FROM ContentVersion 
            WHERE Id =: cv.Id
        ].ContentDocumentId;

        cdl.LinkedEntityId = invoice.Id;
        cdl.ShareType = 'V';
        insert cdl;
    }

    /*
    *	Author: Julián Martínez Cordones <julian@calibre360.io>
    */
    public static String generateRequestBody(String invoiceNumber, String qrURL) {
        QRImageURL qrImageURL = new QRImageURL();
        qrImageURL.url = qrURL;

        QRObjectData qrObjectData = new QRObjectData();
        qrObjectData.type = 'url-static';
        qrObjectData.name = invoiceNumber;
        qrObjectData.data = qrImageURL;

        GenerateQRWrapper requestBodyWrapper = new GenerateQRWrapper();
        requestBodyWrapper.qrs = new List<QRObjectData>{qrObjectData};

        return JSON.serialize(requestBodyWrapper);
    }

    // WRAPPERS
    public class GenerateQRWrapper {
        public List<QRObjectData> qrs;
    }

    public class QRObjectData {
        public String type;
        public String name;
        public QRImageURL data; 
    }

    public class QRImageURL {
        public String url;
    }

    public class GenerateQRResponseWrapper {
        public List<Integer> ids;
    }

