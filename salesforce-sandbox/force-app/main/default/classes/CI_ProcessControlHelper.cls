public class CI_ProcessControlHelper {
    public final static String GENERATE_DATA_MODEL_REMESA   = 'GENERATE_DATA_MODEL_REMESA';
    public final static String GENERATE_XML_SEPA            = 'GENERATE_XML_SEPA';
    public final static String GENERATE_XML_AEAT            = 'GENERATE_XML_AEAT';
    public final static String GENERATE_XML_AEAT_FILE       = 'GENERATE_XML_AEAT_FILE';
    public final static String SEND_XML_VERIFACTU_AEAT      = 'SEND_XML_VERIFACTU_AEAT';
    public final static String GENERATE_QR_VERIFACTU        = 'GENERATE_QR_VERIFACTU';
    public final static String PREPARE_VERIFACTU_AEAT       = 'PREPARE_VERIFACTU_AEAT';

    /* @Method          :   PROCESS_CONTROL_MAP
     * @Author          :   José Ernesto <jose@calibre360.io>
     * @Created         :   18 ene 2024
     * @Description     :   Crear mapa de procesos existente
    */
    public static Map<String, CI_ControlProcesos__mdt> PROCESS_CONTROL_MAP{
        get{
            if(PROCESS_CONTROL_MAP == NULL){
                PROCESS_CONTROL_MAP = new Map<String, CI_ControlProcesos__mdt>();
                List<CI_ControlProcesos__mdt> pcList = new List<CI_ControlProcesos__mdt>(
                    [SELECT MasterLabel,
                            QualifiedApiName,
                            CI_BatchSize__c ,
                            CI_IsActive__c,
                            CI_QueryBatch__c
                     FROM CI_ControlProcesos__mdt]
                );
 
 
                for(CI_ControlProcesos__mdt iList: pcList){
                    PROCESS_CONTROL_MAP.put(
                        iList.QualifiedApiName,
                        iList
                    );
                }
            }
 
 
            return PROCESS_CONTROL_MAP;
        }
        set;
    }
    /*
     * @Method          :   getControlProcess
     * @Author          :   José Ernesto <jose@calibre360.io>
     * @Created         :   18 ene 2024
     * @Description     :   Obtener registro de proceso específico
     */
    public static CI_ControlProcesos__mdt getControlProcess(String processApiName){
        return PROCESS_CONTROL_MAP.get(processApiName);
    }

