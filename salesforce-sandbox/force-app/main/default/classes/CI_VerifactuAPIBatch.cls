global class CI_VerifactuAPIBatch implements Database.Batchable<sObject>, Database.AllowsCallouts {
    String query;
    Integer batchSize;
    Boolean isProcessActive;
    // private Id xmlAEATId;
    // private CI_XMLAEAT__c xmlAEATRecord;
    
    global CI_VerifactuAPIBatch() {
        this.query = CI_ProcessControlHelper.getControlProcess(CI_ProcessControlHelper.SEND_XML_VERIFACTU_AEAT).CI_QueryBatch__c;
        this.batchSize = Integer.valueOf(CI_ProcessControlHelper.getControlProcess(CI_ProcessControlHelper.SEND_XML_VERIFACTU_AEAT).CI_BatchSize__c);
        this.isProcessActive = CI_ProcessControlHelper.getControlProcess(CI_ProcessControlHelper.SEND_XML_VERIFACTU_AEAT).CI_IsActive__c;
        // this.xmlAEATRecord = xmlAEATRecord;
        // xmlAEATId = xmlAEATRecord.Id;
    }

    global Database.QueryLocator start(Database.BatchableContext BC) {
        return Database.getQueryLocator(query);
    }

    global void execute(Database.BatchableContext BC, List<sObject> scope) {
        if (!isProcessActive) {
            return;
        }

        String logXmlResponse = '';
        List<CI_XMLAEAT__c> xmlAEATRetrieved = (List<CI_XMLAEAT__c>) scope;

        try {
            List<CI_RegistroFacturacion__c> registrosFacturacion = [
                SELECT Id, 
                    CI_NumSerieFactura__c, CI_NumSerieFacturaAnulada__c 
                FROM CI_RegistroFacturacion__c 
                WHERE CI_XMLAEAT__c IN: xmlAEATRetrieved
            ];

            Map<String, CI_RegistroFacturacion__c> registrosFacturacionByNumFactura = new Map<String, CI_RegistroFacturacion__c>();

            Integer registrosFacturacionSize = registrosFacturacion.size();
            for (Integer i = 0; i < registrosFacturacionSize; i++) {
                CI_RegistroFacturacion__c registroFacturacion = registrosFacturacion[i];

                // if(registroFacturacion.CI_NumSerieFacturaAnulada__c != null){
                //     registrosFacturacionByNumFactura.put(registroFacturacion.CI_NumSerieFacturaAnulada__c, registroFacturacion);
                // }
                // else{
                    registrosFacturacionByNumFactura.put(registroFacturacion.CI_NumSerieFactura__c, registroFacturacion);
                // }
            }

            Attachment xmlVerifactu = [
                SELECT Id, 
                    ParentId, 
                    Body 
                FROM Attachment 
                WHERE ParentId IN: xmlAEATRetrieved 
                LIMIT 1
            ];

            if (xmlVerifactu != NULL) {
                HttpResponse response = CI_VerifactuSOAPAPI.sendSoapRequest(xmlAEATRetrieved[0], xmlVerifactu);
                logXmlResponse = response.getBody();
                
                CI_CustomLogHelper.addNewLog(
                    'save body response - CI_VerifactuAPIBatch.execute',
                    logXmlResponse,
                    xmlAEATRetrieved[0].Id
                );
                CI_CustomLogHelper.saveCurrentCustomLog();

                if (response.getStatusCode() == 200) {
                    Dom.Document responseAsXml = response.getBodyDocument();

                    Map<String, CI_RegistroFacturacion__c> registrosToUpdate = CI_VerifactuSOAPAPI.parseAEATResponse(
                        responseAsXml, 
                        xmlAEATRetrieved[0], 
                        registrosFacturacionByNumFactura
                    );

                    if (registrosToUpdate != NULL) {
                        update registrosToUpdate.values();
                    }

                    xmlAEATRetrieved[0].CI_EnviadoHacienda__c = TRUE;

                    update xmlAEATRetrieved;
                }
            }
        } 
        catch (Exception e) {
            String data = 'STACK TRACE:\n' + e.getStackTraceString() + '\nMESSAGE:\n' + e.getMessage() + '\nLine:\n' + e.getLineNumber() + '\n' + logXmlResponse;

            CI_CustomLogHelper.addNewLog(
                'CI_VerifactuAPIBatch.execute',
                data,
                xmlAEATRetrieved[0].Id
            );

            CI_CustomLogHelper.saveCurrentCustomLog();
        }
    }

    global void finish(Database.BatchableContext BC) {
        CI_CustomLogHelper.addNewLog(
            'CI_VerifactuAPIBatch.finish',
            'Success'
        );
        
        CI_CustomLogHelper.saveCurrentCustomLog();
    }

    global static void searchAndProcess(){
        Integer batchSize = Integer.valueOf(CI_ProcessControlHelper.getControlProcess(CI_ProcessControlHelper.SEND_XML_VERIFACTU_AEAT).CI_BatchSize__c);
        Database.executeBatch(new CI_VerifactuAPIBatch(), batchSize);
    }

