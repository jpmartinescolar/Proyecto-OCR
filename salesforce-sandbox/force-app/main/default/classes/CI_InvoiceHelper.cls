    //Estados de factura
    public static final String ESTADO_NUEVA                         = 'Nueva';
    public static final String ESTADO_SIN_TRASPASAR                 = 'Sin traspasar';
    public static final String ESTADO_TRASPASADO                    = 'Traspasado';
    public static final String ESTADO_PENDIENTE_VALIDACION          = 'Pendiente validación';
    public static final String ESTADO_VALIDADA                      = 'Validada';
    public static final String ESTADO_ERROR_EN_VALIDACION           = 'Error en validación';

    //Tipo de factura
    public static final String TIPO_FACTURA_NORMAL      = 'Normal';
    public static final String TIPO_FACTURA_ABONO       = 'Abono';
    
    @AuraEnabled
    public static Integer generateInvoicesFromOrders(List<String> orderIds, Date fechaEmision){
        Map<String, List<OrderItem>> mOrderItemsListByKey = new Map<String, List<OrderItem>>();
        Set<Id> sAccountsIds = new Set<Id>();
        
        for(OrderItem iItem: [SELECT Id,Product2Id,TotalPrice,UnitPrice,Quantity,IC_Description__c, 
                                        Tipos_de_IVA__c, Cuota_IVA__c, Comisionista__c, Comisi_n__c, 
                                        Suplido__c, Campa_a__c, Libro_contable__c, Expediente__c, 
                                        Cuentas_Anuales__c, Cuotas_recurrentes__c, CI_UniqueKeyForInvoice__c, 
                                        Event_Registration__c, Renta__c, Tr_mites_Trabajadores__c, Oportunidad__c, 
                                        N_minas__c, Suplido_Expediente__c, Suplidos_cuentas__c, Suplidos_Libros__c, 
                                        Total_comisi_n__c, Cuenta_contable_IVA_repercutido__c, Observaciones_impuestos__c, 
                                        Tipo_comisi_n__c, Comisionista_2__c, Tipo_comisi_n_2__c, comisi_n_2__c, 
                                        Total_comisi_n_2__c, Operaci_n_vinculada__c, Tipo_operaci_n_vinculada__c, 
                                        Operaci_n_intragrupo__c, OrderId, Order.Empresa_Titular__c, Order.Status, 
                                        Order.Estado_Facturaci_n__c,Order.AccountId,
                                        Order.Formas_de_pago__c,
                                        Order.BillingCity,Order.BillingCountryCode,
                                        Order.BillingPostalCode,Order.BillingState,
                                        Order.BillingStateCode,Order.BillingStreet,
                                        Order.TotalAmount,Order.Vencimiento_d_as_primer_plazo__c,Order.N_Plazos__c, 
                                        Order.Nombre_de_la_Empresa__c, Order.Account.CIF__c, 
                                        Order.Account.Contacto_facturaci_n__c, 
                                        Order.Account.Email_entrega_factura_1__c, Order.Account.Email_entrega_factura_2__c, 
                                        Order.Mandato_SEPA__c, 
                                        Order.Empresa_emisora__c, 
                                        Order.Empresa_emisora__r.Name, 
                                        Order.Empresa_emisora__r.CIF__c, 
                                        Order.Agrupaci_n__c 
                                FROM OrderItem 
                                WHERE OrderId IN:orderIds
                                AND Order.AccountId != null//Import mantenerlo, sino las Order darán error al ser guardadas además por calidad de las facturas
                                AND Order.Empresa_Titular__c IN:CI_ConsecutivosFacturasHelper.CONSECUTIVOS_FACTURAS_MAP.keySet()]){//Import mantenerlo, sino se crearán facturas sin consecutivo, una proque sea null el campo en el pedido y otra porque no se haya creado el registro de la empresa en la custom setting
            
            String uniqueKey = iItem.CI_UniqueKeyForInvoice__c;
            
            List<OrderItem> lOrderItems = mOrderItemsListByKey.containsKey(uniqueKey) ? mOrderItemsListByKey.get(uniqueKey) : new List<OrderItem>();				
            lOrderItems.add(iItem);
            mOrderItemsListByKey.put(
                uniqueKey,
                lOrderItems
            );
        }

        List<Facturas__c> lInvoicesToCreate             = new List<Facturas__c>();
        List<L_nea_de_factura__c> lInvoiceItemsToCreate = new List<L_nea_de_factura__c>();
        Set<Id> sOrdersToUpdate                         = new Set<Id>();

        for(String key: mOrderItemsListByKey.keySet()){
            OrderItem iBase                         = mOrderItemsListByKey.get(key)[0];
            Facturas__c newInvoice                  = new Facturas__c();

            newInvoice.Empresa__c                   = iBase.Order.AccountId;
            newInvoice.Nombre_del_cliente__c        = iBase.Order.Nombre_de_la_Empresa__c;
            newInvoice.CIF_Cliente__c               = iBase.Order.Account.CIF__c;
            newInvoice.Empresa_Titular__c           = iBase.Order.Empresa_Titular__c;
            newInvoice.Estado__c                    = CI_InvoiceHelper.ESTADO_NUEVA;
            newInvoice.CI_TipoDeFactura__c          = CI_InvoiceHelper.TIPO_FACTURA_NORMAL;
            newInvoice.N_factura__c                 = CI_ConsecutivosFacturasHelper.CONSECUTIVOS_FACTURAS_MAP.get(iBase.Order.Empresa_Titular__c) != null ? CI_ConsecutivosFacturasHelper.getNormalInvoiceNumber(iBase.Order.Empresa_Titular__c) : null;
            newInvoice.Fecha_factura__c             = fechaEmision;
            newInvoice.Empresa_emisora__c           = iBase.Order.Empresa_emisora__c;
            newInvoice.Nombre_del_emisor__c         = ibase.Order.Empresa_emisora__r.Name;
            newInvoice.CIF_emisor__c                = ibase.Order.Empresa_emisora__r.CIF__c;
            if(iBase.Order.Vencimiento_d_as_primer_plazo__c != null){
                newInvoice.Fecha_vencimiento__c     = fechaEmision.addDays(Integer.valueOf(iBase.Order.Vencimiento_d_as_primer_plazo__c));
            }
            newInvoice.Forma_de_pago__c                         = iBase.Order.Formas_de_pago__c;
            newInvoice.Mandato_SEPA__c                          = iBase.Order.Mandato_SEPA__c;

            newInvoice.Contacto_facturaci_n__c                  = iBase.Order.Account.Contacto_facturaci_n__c;
            newInvoice.Email_entrega_factura_1__c               = iBase.Order.Account.Email_entrega_factura_1__c;
            newInvoice.Email_entrega_factura_2__c               = iBase.Order.Account.Email_entrega_factura_2__c;
            
            newInvoice.Direcci_n_facturaci_n__City__s           = iBase.Order.BillingCity;
            newInvoice.Direcci_n_facturaci_n__CountryCode__s    = iBase.Order.BillingCountryCode;
            newInvoice.Direcci_n_facturaci_n__PostalCode__s     = iBase.Order.BillingPostalCode;
                                                                // iBase.Order.Account.BillingState;
            newInvoice.Direcci_n_facturaci_n__StateCode__s      = iBase.Order.BillingStateCode;
            newInvoice.Direcci_n_facturaci_n__Street__s         = iBase.Order.BillingStreet;

            newInvoice.N_plazos__c                              = iBase.Order.N_Plazos__c;
            newInvoice.Agrupaci_n__c                            = iBase.Order.Agrupaci_n__c;

            lInvoicesToCreate.add(newInvoice);

            for(OrderItem iItem: mOrderItemsListByKey.get(key)){
                sOrdersToUpdate.add(iItem.OrderId);

                L_nea_de_factura__c iLine                       = new L_nea_de_factura__c();
                iLine.Factura__r                                = newInvoice;
                iLine.Producto_de_pedido__c                     = iItem.Id;
                iLine.Productos_y_Servicios__c                  = iItem.Product2Id;
                iLine.Precio__c                                 = iItem.UnitPrice;
                iLine.Cantidad__c                               = iItem.Quantity;
                iLine.CI_ImporteBase__c                         = iItem.TotalPrice;
                iLine.CI_Descripcion__c                         = iItem.IC_Description__c;
                iLine.Pedido__c                                 = iItem.OrderId;
                iLine.Tipos_de_IVA__c                           = iItem.Tipos_de_IVA__c;
                iLine.Cuota_IVA__c                              = iItem.Cuota_IVA__c;
                iLine.Comisionista__c                           = iItem.Comisionista__c;
                iLine.Comisi_n__c                               = iItem.Comisi_n__c;
                iLine.Suplidos__c                               = iItem.Suplido__c;
                iLine.Campa_a__c                                = iItem.Campa_a__c;
                iLine.Libro_contable__c                         = iItem.Libro_contable__c;
                iLine.Expediente__c                             = iItem.Expediente__c;
                iLine.Cuentas_Anuales__c                        = iItem.Cuentas_Anuales__c;
                iLine.Cuotas_recurrentes__c                     = iItem.Cuotas_recurrentes__c;
                iLine.Event_Registration__c                     = iItem.Event_Registration__c;
                iLine.Renta__c                                  = iItem.Renta__c;
                iLine.Tr_mites_Trabajadores__c                  = iItem.Tr_mites_Trabajadores__c;
                iLine.Oportunidad__c                            = iItem.Oportunidad__c;
                iLine.N_minas__c                                = iItem.N_minas__c;
                iLine.Suplido_Expediente__c                     = iItem.Suplido_Expediente__c;
                iLine.Suplido_Cuentas__c                        = iItem.Suplidos_cuentas__c;
                iLine.Suplidos_Libros__c                        = iItem.Suplidos_Libros__c;
                iLine.Cuota_comisi_n__c                         = iItem.Total_comisi_n__c;
                iLine.Cuenta_contable_IVA_repercutido__c        = iItem.Cuenta_contable_IVA_repercutido__c;
                iLine.Observaciones_impuesto__c                 = iItem.Observaciones_impuestos__c;
                iLine.Tipo_comisi_n__c                          = iItem.Tipo_comisi_n__c;
                iLine.Comisionista_2__c                         = iItem.Comisionista_2__c;
                iLine.Tipo_comisi_n_2__c                        = iItem.Tipo_comisi_n_2__c;
                iLine.comisi_n_2__c                             = iItem.comisi_n_2__c;
                iLine.Total_comisi_n_2__c                       = iItem.Total_comisi_n_2__c;
                iLine.Operaci_n_vinculada__c                    = iItem.Operaci_n_vinculada__c;
                iLine.Tipo_operaci_n_vinculada__c               = iItem.Tipo_operaci_n_vinculada__c;
                iLine.Operaci_n_intragrupo__c                   = iItem.Operaci_n_intragrupo__c;

                lInvoiceItemsToCreate.add(iLine);
            }
        }

        if(!lInvoicesToCreate.isEmpty()){
            insert lInvoicesToCreate;
        }

        //Actualizar consecutivos en custom setting
        CI_ConsecutivosFacturasHelper.updateRecords();

        //Set<Id> sInvoiceToUpdate = new Set<Id>();
        Map<Id, Id> invoiceGeneratedIdsByOrderBilledIds = new Map<Id, Id>();
        //Relacionando Item-Invoice
        for(L_nea_de_factura__c iItem: lInvoiceItemsToCreate){
            iItem.Factura__c = iItem.Factura__r.Id;

            //sInvoiceToUpdate.add(iItem.Factura__r.Id);
            invoiceGeneratedIdsByOrderBilledIds.put(iItem.Pedido__c, iItem.Factura__c);
        }

        if(!lInvoiceItemsToCreate.isEmpty()){
            insert lInvoiceItemsToCreate;
        }

        //Pasar el estado de las factura para que se envíen al ERP
        CI_InvoiceHelper.updateInvoiceToValidada(lInvoicesToCreate);

        update lInvoicesToCreate;

        //Actualizar estado de Pedidos para que no se vuelvan a procesar
        CI_OrderHelper.updateBilledOrders(sOrdersToUpdate, invoiceGeneratedIdsByOrderBilledIds);


        return lInvoicesToCreate.size();
    }
    /*
     *   @Author             :   José Ernesto <jose@calibre360.io>
     *   @Created            :   19 Oct 2023
     *   @Description        :   Pasar facturas a ESTADO_VALIDADA
     *   @Updated By         :   Julián Martínez <julian@calibre360.io>
     */
    public static void updateInvoiceToValidada(List<Facturas__c> invoices){
        Integer invoicesSize = invoices.size();
        for (Integer i = 0; i < invoicesSize; i++) {
            Facturas__c invoice = invoices[i];

            invoice.Estado__c = CI_InvoiceHelper.ESTADO_VALIDADA;
        }
    }

