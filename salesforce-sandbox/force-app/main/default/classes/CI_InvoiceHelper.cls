    public static void setHashKey(Set<Id> sInvoicesIds) {
        List<Facturas__c> lInvoicesToUpdate = new List<Facturas__c>();

        List<Facturas__c> lInvoices = new List<Facturas__c>([
            SELECT Id, CIF_emisor__c, Fecha_factura__c, CI_TipoDeFactura__c,
                    N_factura__c, CI_TipoFacturaAEAT__c, IVA__c, Importe_factura__c,
                    CI_FacturaAnterior__c, CI_FacturaAnterior__r.CI_HashAEAT__c, 
                    Factura_origen__c , Factura_origen__r.CIF_emisor__c, 
                    Factura_origen__r.N_factura__c, Factura_origen__r.CI_FechaExpedicionFacturaAEAT__c, 
                    Factura_origen__r.Fecha_factura__c 
            FROM Facturas__c
            WHERE Id IN:sInvoicesIds
        ]);

        Map<String, List<Facturas__c>> invoicesByEmpresaTitular = new Map<String, List<Facturas__c>>();

        for(Facturas__c iInv: lInvoices){
            if (invoicesByEmpresaTitular.get(iInv.CIF_emisor__c) != NULL) {
                invoicesByEmpresaTitular.get(iInv.CIF_emisor__c).add(iInv);
            } else {
                invoicesByEmpresaTitular.put(iInv.CIF_emisor__c, new List<Facturas__c>{iInv});
            }
        }

        for (String cifEmpresa : invoicesByEmpresaTitular.keySet()) {
            List<Facturas__c> invoices = invoicesByEmpresaTitular.get(cifEmpresa);

            Integer invoicesSize = invoices.size();
            for (Integer i = 0; i < invoicesSize; i++) {
                Facturas__c invoice = invoices[i];

                // Datetime dt = Datetime.newInstance(invoice.Fecha_factura__c, Time.newInstance(0, 0, 0, 0));
                // if (invoice.CI_TipoDeFactura__c == CI_InvoiceHelper.TIPO_FACTURA_ABONO) {
                //     dt = Datetime.newInstance(invoice.Factura_origen__r.Fecha_factura__c, Time.newInstance(0, 0, 0, 0));
                // }
                
                // String fechaExpedicion          = dt.format('dd-MM-yyyy');
                String fechaExpedicion          = System.now().format('dd-MM-yyyy');
                String fechaHoraHusoRegistro    = System.now().format('yyyy-MM-dd\'T\'HH:mm:ssXXX');
                
                String hashPrevio = invoice.CI_FacturaAnterior__c == NULL ? '' : invoice.CI_FacturaAnterior__r.CI_HashAEAT__c;
                String hash = '';
                String saveDataHash = '';

                hash = CI_VerifactuUtilities.generateHashKey(
                    invoice,
                    fechaExpedicion,
                    hashPrevio, 
                    fechaHoraHusoRegistro
                );

                saveDataHash = CI_VerifactuUtilities.getStringHash(
                    invoice,
                    fechaExpedicion,
                    hashPrevio, 
                    fechaHoraHusoRegistro
                );

                invoice.CI_SalvaDatosHash__c                = saveDataHash;
                invoice.CI_HashAEAT__c                      = hash;
                invoice.CI_FechaExpedicionFacturaAEAT__c    = fechaExpedicion;
                invoice.CI_FechaHoraHusoGenRegistroAEAT__c  = fechaHoraHusoRegistro;

                lInvoicesToUpdate.add(invoice);
            }
        }

        if(!lInvoicesToUpdate.isEmpty()){
            update lInvoicesToUpdate;
        }
    }

