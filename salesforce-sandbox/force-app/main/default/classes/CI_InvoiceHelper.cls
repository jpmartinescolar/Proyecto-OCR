    */
    public static Map<String, Facturas__c> getBusinessUnitLastInvoice(Map<String, String> lastInvoiceNumberByCIF) {
        List<Facturas__c> lastInvoices = [
            SELECT Id, 
                N_Factura__c, 
                CIF_emisor__c, 
                CI_HashAEAT__c,
                CreatedDate 
            FROM Facturas__c 
            WHERE N_Factura__c IN: lastInvoiceNumberByCIF.values()
        ];

        Map<String, Facturas__c> businessUnitLastInvoice = new Map<String, Facturas__c>();

        Integer lastInvoicesSize = lastInvoices.size();
        for (Integer i = 0; i < lastInvoicesSize; i++) {
            Facturas__c lastInvoice = lastInvoices[i];

            businessUnitLastInvoice.put(lastInvoice.CIF_emisor__c, lastInvoice);
        }

        return businessUnitLastInvoice;
    }

    /*
     *   @Author             :   José Ernesto <jose@calibre360.io>
     *   @Created            :   22 Nov 2025
     *   @Description        :   Obtener # factura anterior, sin importar si es normal o abono
     */
    public static String getLastInvoiceNumber(String invoiceNumber) {
        List<Facturas__c> currentList = [
            SELECT Id, Name, CreatedDate, N_factura__c, CIF_emisor__c
            FROM Facturas__c
            WHERE N_factura__c =:invoiceNumber
            LIMIT 1
        ];

        Facturas__c currentInv = currentList[0];

        List<Facturas__c> prevList = [
            SELECT Id, Name, CreatedDate, N_factura__c, CIF_emisor__c
            FROM Facturas__c
            WHERE CIF_emisor__c =:currentInv.CIF_emisor__c 
            AND N_factura__c != NULL
            AND ((CreatedDate < :currentInv.CreatedDate) OR (CreatedDate = :currentInv.CreatedDate AND Id < :currentInv.Id))
            ORDER BY CreatedDate DESC, Id DESC
            LIMIT 1
        ];

        return prevList[0].N_factura__c;
    }

    /*
     *   @Author             :   José Ernesto <jose@calibre360.io>
     *   @Created            :   22 Nov 2025
     *   @Description        :   Asignar factura anterior a una factura
     */
    public static void updateBeforeInvoice(Map<String, Facturas__c> mInvoicesByInvoiceNumber, Map<String, Facturas__c> mInvoicesByBeforeInvoiceNumber){
        List<Facturas__c> lInvToUpdateHere = new List<Facturas__c>();
        for(String beforeInvNum: mInvoicesByBeforeInvoiceNumber.keySet()){
            Facturas__c invToUpdate = mInvoicesByBeforeInvoiceNumber.get(beforeInvNum);

            if(!mInvoicesByInvoiceNumber.containsKey(beforeInvNum)){
                //Sólo se hará una consulta, sólo una de las facturas que se recibe no estará dentro de mInvoicesByInvoiceNumber
                Facturas__c firstInv = [SELECT Id FROM Facturas__c WHERE N_factura__c =:beforeInvNum LIMIT 1];
                invToUpdate.CI_FacturaAnterior__c = firstInv.Id;
            }
            else{
                invToUpdate.CI_FacturaAnterior__c = mInvoicesByInvoiceNumber.get(beforeInvNum).Id;
            }

            lInvToUpdateHere.add(invToUpdate);
        }

        if(!lInvToUpdateHere.isEmpty()){
            update lInvToUpdateHere;
        }
    } 
    /*
     *   @Author             :   José Ernesto <jose@calibre360.io>
     *   @Created            :   22 Nov 2025
     *   @Description        :   Marcar factura como preparada para Verifactu
     */
    public static void setInvoiceAsVerifactuPrepared(Set<Id> sInvoices){
        List<Facturas__c> lInvToUpdateHere = new List<Facturas__c>([
            SELECT Id, CI_VerifactuPrepared__c, CI_IncluirXMLAEAT__c 
            FROM Facturas__c 
            WHERE Id IN:sInvoices
        ]);
        
        for(Facturas__c iInv: lInvToUpdateHere){
            iInv.CI_VerifactuPrepared__c    = true;
            iInv.CI_IncluirXMLAEAT__c       = true;
        }

        if(!lInvToUpdateHere.isEmpty()){
            update lInvToUpdateHere;
        }
    }
    /*
     *   @Author             :   José Ernesto <jose@calibre360.io>
     *   @Created            :   29 Nov 2025
     *   @Description        :   Marcar factura como procesada
     */
    public static void setInvoiceAsProceced(Set<Id> sInvoices){
        List<Facturas__c> lInvToUpdateHere = new List<Facturas__c>([
            SELECT Id, CI_RevisadaVerifactu__c 
            FROM Facturas__c 
            WHERE Id IN:sInvoices
        ]);
        
        for(Facturas__c iInv: lInvToUpdateHere){
            iInv.CI_RevisadaVerifactu__c = true;
        }

        if(!lInvToUpdateHere.isEmpty()){
            update lInvToUpdateHere;
        }
    }

