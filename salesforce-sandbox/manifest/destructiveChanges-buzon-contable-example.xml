        <name>CustomTab</name>
    </types>
    <!--
      Estos dos van al final: borrar el CustomObject y el CustomMetadata Type
      arrastra automaticamente todos sus campos (Buzon_test__c tiene 12,
      Buzon_Test_Config__mdt tiene 3). Hacerlo antes de borrar lo de arriba
      puede fallar por dependencias (tab, flexipage y permission sets los
      referencian).
    -->
    <types>
        <members>Buzon_test__c</members>
        <members>Buzon_Test_Config__mdt</members>
        <name>CustomObject</name>
    </types>
